{
  "name": "enterprise/blog-backend",
  "description": "Enterprise Multi-author Blog Backend with Clean Architecture",
  "type": "project",
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^6.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "src\\Domain\\": "src/Domain/",
      "src\\Application\\": "src/Application/",
      "src\\Infrastructure\\": "src/Infrastructure/",
      "src\\WebApi\\": "src/WebApi/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}