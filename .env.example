# PostgreSQL Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=blog_db
DB_USERNAME=blog_user
DB_PASSWORD=blog_secret

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Security & JWT
JWT_SECRET=super_secret_jwt_key_32_chars_long
JWT_TTL=86400

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api

# Backend CORS (nhiều origin cách nhau bằng dấu phẩy)
CORS_ORIGIN=http://localhost:3000