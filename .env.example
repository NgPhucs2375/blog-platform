# Docker Compose defaults only; Laragon uses be/.env.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=blog_platform
DB_USERNAME=blog_user
DB_PASSWORD=blog_secret
MYSQL_ROOT_PASSWORD=local_root_password
APP_KEY=
APP_DEBUG=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api

# Backend CORS (origins cách nhau bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
